RELIEFLINK_ADMIN_PIN=1234
RELIEFLINK_PORT=8000
RELIEFLINK_MONGO_URL=mongodb://localhost:27017
RELIEFLINK_MONGO_DB=relieflink

# AI server = the Mac running Ollama. Use the Mac's current IP.
# Can also be changed later from the dashboard (AI server settings) without restarting.
OLLAMA_BASE_URL=http://MAC_IP:11434
# Exact tag from `ollama list` on the Mac
OLLAMA_MODEL=your-installed-model-tag
